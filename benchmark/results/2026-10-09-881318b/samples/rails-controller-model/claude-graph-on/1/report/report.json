      "line_end": 16,
      "title": "Mass assignment lets users grant themselves admin",
      "description": "The profile action permits every attribute in params[:user] without a filter. The User model has admin and api_token attributes that the authentication and admin checks trust. Any authenticated user can set admin to true and gain admin access. The same user can also overwrite their api_token. Permit only the profile fields users may edit, such as email.",
      "suggested_change": "    @current_user.update!(params.require(:user).permit(:email))",

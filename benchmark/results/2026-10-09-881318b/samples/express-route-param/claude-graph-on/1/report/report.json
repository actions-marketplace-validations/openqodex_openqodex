      "confidence": 0.95,
      "file_path": "src/handlers/users.js",
      "line_number": 8,
      "line_end": 9,
      "title": "Handler reads a route param that does not exist",
      "description": "getUser reads req.params.userId. The route in src/routes/users.js:7 declares the param as :id, so userId is always undefined. findUser(undefined) returns nothing, so every GET /users/:id call gets a 404. The 404 message also reads 'no user with id undefined'. Read the id param that the route defines. Renaming the route param to :userId would also work.",
      "suggested_change": "  const { id: userId } = req.params;\n  const user = findUser(userId);",
      "source": null,
      "candidate": null,
      "notes": [],
      "problem": "getUser reads req.params.userId. The route in src/routes/users.js:7 declares the param as :id, so userId is always undefined.",
      "consequence": "findUser(undefined) returns nothing, so every GET /users/:id call gets a 404. The 404 message also reads 'no user with id undefined'.",
      "fix": "Read the id param that the route defines. Renaming the route param to :userId would also work."
    },
    {
      "origin": "agent",
      "severity": "minor",
      "category": "maintainability",
      "confidence": 0.75,
      "file_path": "src/handlers/users.js",

      "severity": "major",
      "category": "bug",
      "confidence": 0.93,
      "file_path": "internal/api/handler.go",
      "line_number": 83,
      "line_end": 83,
      "title": "Response body closed before error check",
      "description": "fetchStatus defers resp.Body.Close before it checks err. When http.Get fails, resp is nil. An unreachable upstream makes Upstream panic on a nil pointer. The client gets a dropped connection instead of the intended 502. Move the deferred Close below the error check.",
      "suggested_change": null,

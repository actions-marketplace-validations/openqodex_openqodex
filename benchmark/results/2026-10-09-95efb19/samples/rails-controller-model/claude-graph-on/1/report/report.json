      "file_path": "app/controllers/users_controller.rb",
      "line_number": 2,
      "line_end": 2,
      "title": "Destroy skips the admin check",
      "description": "The before_action exempts destroy from require_admin. The destroy action then finds any user by id with no scoping to the caller. Any authenticated user can delete any other user account, including admins. Remove destroy from the except list so only admins reach it, or scope the lookup to the current user.",
      "suggested_change": "  before_action :require_admin, except: [:index, :show, :profile]",
      "source": "semgrep:ruby.rails.security.brakeman.check-unscoped-find.check-unscoped-find",
      "candidate": "c2",
      "notes": [],
      "problem": "The before_action exempts destroy from require_admin. The destroy action then finds any user by id with no scoping to the caller.",
      "consequence": "Any authenticated user can delete any other user account, including admins.",
      "fix": "Remove destroy from the except list so only admins reach it, or scope the lookup to the current user."
    },

      "severity": "critical",
      "category": "security",
      "confidence": 0.95,
      "file_path": "tools/thumbs.py",
      "line_number": 9,
      "line_end": 9,
      "title": "Upload name interpolated into a shell command",
      "description": "make_thumbnail puts upload_name, which comes from the upload form, into a shell string run with shell=True. A name holding characters like ; or $( ) runs extra commands. Any user who can upload a file can run commands on the server. The added nosec comment hides this from review. Pass an argument list without shell=True. Also reduce upload_name to its base name so a ../ path cannot escape the folders.",
      "suggested_change": "    subprocess.run([\"convert\", f\"{UPLOAD_DIR}/{upload_name}\", \"-resize\", \"128x128\", f\"{THUMB_DIR}/{upload_name}\"], check=True)",
      "source": "semgrep:python.lang.security.audit.subprocess-shell-true.subprocess-shell-true",
      "candidate": "c1",
      "notes": [],
      "problem": "make_thumbnail puts upload_name, which comes from the upload form, into a shell string run with shell=True. A name holding characters like ; or $( ) runs extra commands.",
      "consequence": "Any user who can upload a file can run commands on the server. The added nosec comment hides this from review.",
      "fix": "Pass an argument list without shell=True. Also reduce upload_name to its base name so a ../ path cannot escape the folders."
    },

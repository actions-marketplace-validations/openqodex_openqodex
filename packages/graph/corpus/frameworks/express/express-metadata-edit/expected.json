{
  "guards": "finds the routes of an unchanged file once a manifest change declares express",
  "frameworks": {
    "plugin": "express",
    "apps": 1,
    "registrations": [
      { "site": "src/server.ts:5", "methods": ["GET"], "pattern": "/ping", "handler": "src/ping.ts#ping", "status": "bound", "mounted": true }
    ],
    "roles": [{ "target": "src/ping.ts#ping", "role": "route_handler", "detail": "express" }]
  }
}
